#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_PerViewData
{
    float4x4 _ViewMatrix;
    float4x4 _ViewProjectionMatrix;
    float4x4 _ProjectionMatrix;
    float4 _ViewPosition;
    float2 _PixelResolution;
    float _FarPlane;
    float _NearPlane;
};

struct type_LayerData
{
    float4x4 _LayerTransform;
};

struct FUIDrawItem
{
    int shaderType;
    uint textureIndex;
    uint samplerIndex;
    int flags;
    int clipRectIndex;
    int gradientStartIndex;
    int gradientStopCount;
    uint userFlags;
    float data[32];
};

struct type_StructuredBuffer_FUIDrawItem
{
    FUIDrawItem _m0[1];
};

struct FUIClipRect
{
    float4x4 clipInverseTransform;
    float4 cornerRadii;
    float2 clipHalfSize;
    int _pad[2];
};

struct type_StructuredBuffer_FUIClipRect
{
    FUIClipRect _m0[1];
};

struct FUIGradientStop
{
    uint packedColor;
    float position;
};

struct type_StructuredBuffer_FUIGradientStop
{
    FUIGradientStop _m0[1];
};

struct spvDescriptorSetBuffer1
{
    constant type_PerViewData* _PerViewData [[id(0)]];
};

struct spvDescriptorSetBuffer3
{
    constant type_LayerData* _LayerData [[id(0)]];
};

struct VertMain_out
{
    float2 out_var_TEXCOORD1 [[user(locn0)]];
    float4 out_var_TEXCOORD2 [[user(locn1)]];
    uint out_var_TEXCOORD3 [[user(locn2)]];
    float2 out_var_TEXCOORD4 [[user(locn3)]];
    float4 gl_Position [[position]];
};

struct VertMain_in
{
    float2 in_var_POSITION [[attribute(0)]];
    float2 in_var_TEXCOORD0 [[attribute(1)]];
    float4 in_var_COLOR0 [[attribute(2)]];
    uint in_var_TEXCOORD1 [[attribute(3)]];
};

vertex VertMain_out VertMain(VertMain_in in [[stage_in]], constant spvDescriptorSetBuffer1& spvDescriptorSet1 [[buffer(1)]], constant spvDescriptorSetBuffer3& spvDescriptorSet3 [[buffer(3)]])
{
    VertMain_out out = {};
    out.gl_Position = (float4(in.in_var_POSITION, 0.0, 1.0) * (*spvDescriptorSet3._LayerData)._LayerTransform) * (*spvDescriptorSet1._PerViewData)._ViewProjectionMatrix;
    out.out_var_TEXCOORD1 = in.in_var_TEXCOORD0;
    out.out_var_TEXCOORD2 = in.in_var_COLOR0;
    out.out_var_TEXCOORD3 = in.in_var_TEXCOORD1;
    out.out_var_TEXCOORD4 = in.in_var_POSITION;
    return out;
}

